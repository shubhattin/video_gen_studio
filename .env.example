# Deployment used by `bunx convex dev`
CONVEX_DEPLOYMENT=dev:example-project

# Frontend-only Convex client URL (safe to expose in the browser bundle)
VITE_CONVEX_URL=https://example-project.convex.cloud

# Required for forced file downloads (Content-Disposition via Convex HTTP)
VITE_CONVEX_SITE_URL=https://example-project.convex.site

# Server-only provider keys — configure these in the Convex deployment dashboard.
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Server-side terminal-frame processor (optional).
# Continuation mode works without this: the browser extracts the continuity frame.
# Set these in Convex only when you want server-side extraction (deployed app URL
# that Convex can reach — localhost will not work from the Convex cloud).
# VIDEO_PROCESSOR_URL=https://your-deployed-app.example
# VIDEO_PROCESSOR_SHARED_SECRET="use-the-same-long-random-secret-in-both-runtimes"
# Must equal the origin returned by Convex storage URLs, for example:
# VIDEO_PROCESSOR_ALLOWED_SOURCE_ORIGIN=https://example-project.convex.cloud
