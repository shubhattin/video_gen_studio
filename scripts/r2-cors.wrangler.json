{
	"rules": [
		{
			"allowed": {
				"origins": [
					"http://localhost:3000",
					"http://127.0.0.1:3000"
				],
				"methods": ["GET", "HEAD", "PUT"],
				"headers": ["*"]
			},
			"exposeHeaders": [
				"ETag",
				"Content-Length",
				"Content-Type",
				"Content-Range",
				"Accept-Ranges"
			],
			"maxAgeSeconds": 3600
		}
	]
}
