# Deployment used by `bunx convex dev`
CONVEX_DEPLOYMENT=dev:example-project

# Frontend-only Convex client URL (safe to expose in the browser bundle)
VITE_CONVEX_URL=https://example-project.convex.cloud

# Browser Better Auth origin (cookies + GET /api/auth/token). Same value as JWT iss/aud.
VITE_BETTER_AUTH_URL="http://localhost:5188"

# Convex dashboard only (not VITE_* / not the browser bundle).
# Server-only provider keys — configure these in the Convex deployment dashboard.
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Cloudflare R2 (S3-compatible) — set in the Convex deployment only (not Vercel / not VITE_*).
CLOUDFLARE_ACCOUNT_ID="id"
R2_ACCESS_KEY_ID="id"
R2_SECRET_ACCESS_KEY="secret-key"
R2_BUCKET_NAME="bucket_name"

# Exact Better Auth base URL. Must match the JWT `iss` and `aud` claims.
# Convex customJwt uses this as both issuer and applicationID.
BETTER_AUTH_ISSUER="https://your-better-auth-domain.com"

# Public JWKS URL. Better Auth serves this at `{issuer}/api/auth/jwks`.
# Convex Cloud fetches this itself (not your laptop). The hostname must be a
# valid DNS label (hyphens, not underscores) so rustls can match `*.domain`.
# Local tunnels with `_` in the name fail TLS even when curl succeeds; use a
# hyphenated hostname, or a Convex data URI: data:text/plain;charset=utf-8;base64,...
JWKS_ENDPOINT="https://your-better-auth-domain.com/api/auth/jwks"

# Browser origin allowed to call the authenticated /studio/media HTTP fallback.
VIDEO_APP_ORIGIN="http://localhost:3000"
