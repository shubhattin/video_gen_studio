# Deployment used by `bunx convex dev`
CONVEX_DEPLOYMENT=dev:example-project

# Frontend-only Convex client URL (safe to expose in the browser bundle)
VITE_CONVEX_URL=https://example-project.convex.cloud

# Both connvex and main
VITE_BETTER_AUTH_URL="http://localhost:5188"

#$ Convex only configs
# Server-only provider keys — configure these in the Convex deployment dashboard.
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Cloudflare R2 (S3-compatible) — set in the Convex deployment only (not Vercel / not VITE_*).
CLOUDFLARE_ACCOUNT_ID="id"
R2_ACCESS_KEY_ID="id"
R2_SECRET_ACCESS_KEY="secret-key"
R2_BUCKET_NAME="bucket_name"
